# Copia este archivo a `.env` y rellena con los valores reales de Supabase.

# ─── Base de datos (Prisma) ───────────────────────────────────────
# Supabase → Project Settings → Database → Connection string

# App (runtime): Transaction pooler, puerto 6543 (incluye ?pgbouncer=true)
DATABASE_URL="postgresql://postgres.[REF]:[PASSWORD]@aws-0-[REGION].pooler.supabase.com:6543/postgres?pgbouncer=true"

# Migraciones (Prisma): conexión directa/session, puerto 5432
DIRECT_URL="postgresql://postgres.[REF]:[PASSWORD]@aws-0-[REGION].pooler.supabase.com:5432/postgres"

# ─── Autenticación (Supabase Auth, se usa en Fase 1) ──────────────
# Supabase → Project Settings → API Keys
NEXT_PUBLIC_SUPABASE_URL="https://[REF].supabase.co"
# Usa la llave publicable (sb_publishable_...): la "anon" antigua deja de
# funcionar a finales de 2026. El nombre de la variable se queda igual.
NEXT_PUBLIC_SUPABASE_ANON_KEY="sb_publishable_..."

# ─── Google Calendar (Fase 3) ─────────────────────────────────────
# Google Cloud Console → APIs & Services → Credentials → OAuth client ID (Web)
# (No hace falta en el deploy de la demo: ahí se usa DEMO=true y citas sembradas.)
GOOGLE_CLIENT_ID="tu-client-id.apps.googleusercontent.com"
GOOGLE_CLIENT_SECRET="tu-client-secret"
GOOGLE_REDIRECT_URI="http://localhost:3000/api/google/callback"

# ─── Modo demo (solo en el deploy de portafolio) ──────────────────
# Con DEMO=true: login de invitado, datos ficticios y reinicio diario.
# NUNCA activarlo contra la base de datos del cliente (el seed la borra).
# DEMO="true"
# Usuario invitado (créalo en Supabase Auth de la demo). Usa una contraseña
# larga: no hay valores por defecto.
# DEMO_EMAIL="demo@demo.com"
# DEMO_PASSWORD="una-contraseña-larga-y-aleatoria"
# Llave secreta (sb_secret_...) del proyecto de Supabase DE LA DEMO (nunca la
# del cliente). Si un visitante le cambia la contraseña al invitado, el botón
# de la demo la restablece. Solo se usa en el servidor.
# SUPABASE_SECRET_KEY="sb_secret_..."
# Opcional: ID del invitado (si no, se busca por DEMO_EMAIL).
# DEMO_USER_ID="..."
# Protege /api/demo/reset (Vercel lo manda en el cron como Bearer).
# CRON_SECRET="un-secreto-largo"

# ─── Opcionales ───────────────────────────────────────────────────
# URL pública para los enlaces absolutos (imagen al compartir). En Vercel
# se usa sola la del dominio de producción; defínela con dominio propio.
# SITE_URL="https://tu-dominio.com"
# Imprime las consultas SQL de Prisma en desarrollo.
# PRISMA_LOG="query"
